// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurante {
  id           String      @id @default(uuid())
  nome         String
  slugWhatsapp String      @unique
  donoWhatsapp String
  strapiId     Int?        @unique // legado — null para restaurantes criados pelo painel
  ativo        Boolean     @default(true)
  moeda        String      @default("R$")
  taxaEntrega  Float       @default(0)
  email               String?     @unique
  senhaHash           String?
  horarioAtendimento  String?     // JSON: { ativo, descricao, dias: { "0": { aberto, abertura, fechamento }, ... } }
  cardapioPdfUrl      String?
  dadosTransferencia  String?     // Dados para PIX/transferência exibidos ao cliente
  instrucoes          String?     // Instruções livres para o agente IA (recheios de borda, regras de tamanho, etc.)
  instanceEvolution   String?     // Nome da instância na Evolution API (se diferente do slugWhatsapp)
  sessoes              Sessao[]
  pedidos              Pedido[]
  turnosCaixa          TurnoCaixa[]
  categorias           Categoria[]
  programasFidelidade  ProgramaFidelidade[]
  motoboys             Motoboy[]
  clientesFidelidade   ClienteFidelidade[]
  campanhas            CampanhaMarketing[]
  itensEstoque         ItemEstoque[]
  custosMensais        CustoMensal[]
  promocoes            Promocao[]
  createdAt            DateTime    @default(now())
}

model Categoria {
  id             String      @id @default(uuid())
  nome           String
  ordem          Int         @default(0)
  ativo          Boolean     @default(true)
  tamanhos       Json        @default("[]")
  tipoTamanhos   String      @default("simples")
  bordas         Json        @default("[]")
  imagemUrl      String?
  ocultarMobile  Boolean     @default(false)
  restauranteId  String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  produtos      Produto[]
  createdAt     DateTime    @default(now())
}

model Produto {
  id          String    @id @default(uuid())
  nome        String
  descricao   String?
  imagemUrl   String?
  preco       Float     @default(0)
  ativo       Boolean   @default(true)
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  tamanhos    Tamanho[]
  createdAt   DateTime  @default(now())
}

model Tamanho {
  id            String  @id @default(uuid())
  nome          String
  preco         Float
  precoComBorda Float?
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Sessao {
  id              String      @id @default(uuid())
  clienteNumero   String // número WhatsApp do cliente
  clienteNome     String?
  restauranteId   String
  restaurante     Restaurante @relation(fields: [restauranteId], references: [id])
  estado          String      @default("INICIO")
  // estados: INICIO, VENDO_CARDAPIO, ADICIONANDO_ITEM, CONFIRMANDO_PEDIDO, AGUARDANDO_LOCALIZACAO, FINALIZADO
  carrinho        Json        @default("[]")
  botPausado          Boolean     @default(false)
  localizacaoPendente String?
  lembreteEnviado     Boolean     @default(false)
  mensagens           Mensagem[]
  pedido              Pedido?
  ultimaAtividade DateTime    @default(now())
  createdAt       DateTime    @default(now())
}

model Mensagem {
  id        String   @id @default(uuid())
  sessaoId  String
  sessao    Sessao   @relation(fields: [sessaoId], references: [id])
  role      String // "cliente" ou "bot"
  conteudo  String
  createdAt DateTime @default(now())
}

model Pedido {
  id            String      @id @default(uuid())
  sessaoId      String      @unique
  sessao        Sessao      @relation(fields: [sessaoId], references: [id])
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  clienteNumero String
  clienteNome   String?
  itens         Json // [{nome, preco, quantidade}]
  total         Float
  localizacao      String? // link Google Maps ou texto do endereço
  metodoPagamento  String? // Dinheiro | Cartão | Transferência
  status        String      @default("NOVO") // NOVO, CONFIRMADO, PAGO, PREPARANDO, SAIU_PARA_ENTREGA, PRONTO_PARA_RETIRADA, ENTREGUE, CANCELADO
  pago          Boolean     @default(false)
  motoboyId     String?     // ID do motoboy despachado (sem FK para preservar histórico)
  motoboyNome   String?     // nome denormalizado para exibição
  mesa          Int?        // número da mesa (null = pedido via WhatsApp)
  origem        String      @default("WHATSAPP") // WHATSAPP | MESA
  numeroDia      Int?        // sequencial diário reiniciado a cada dia por restaurante
  comprovanteUrl String?    // URL da foto do comprovante de pagamento enviado pelo cliente
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ClienteFidelidade {
  id            String      @id @default(uuid())
  numero        String
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome          String?
  totalPedidos  Int         @default(0)
  totalGasto    Float       @default(0)
  resgates      Int         @default(0)
  ultimoPedido  DateTime?
  createdAt     DateTime    @default(now())

  @@unique([numero, restauranteId])
}

model ProgramaFidelidade {
  id            String               @id @default(uuid())
  restauranteId String
  restaurante   Restaurante          @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  tipo          String               @default("PEDIDOS") // PEDIDOS | VALOR
  meta          Float                // ex: 10 pedidos, ou R$ 500 em gastos
  ativo         Boolean              @default(true)
  resgates      ResgateFidelidade[]
  createdAt     DateTime             @default(now())
}

model ResgateFidelidade {
  id            String             @id @default(uuid())
  programaId    String
  programa      ProgramaFidelidade @relation(fields: [programaId], references: [id], onDelete: Cascade)
  clienteNumero String
  clienteNome   String?
  registradoPor String             @default("admin")
  createdAt     DateTime           @default(now())
}

model Motoboy {
  id            String      @id @default(uuid())
  nome          String
  telefone      String      // número WhatsApp (só dígitos)
  cedula        String?     // número de cédula de identidade
  placa         String?     // placa da moto
  senhaHash     String?     // senha para login no painel do motoboy (bcrypt)
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  ativo         Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

model CampanhaMarketing {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  titulo        String
  mensagem      String
  segmento      String
  totalEnviados Int         @default(0)
  totalErros    Int         @default(0)
  criadoEm      DateTime    @default(now())
  criadoPor     String?
}

model ItemEstoque {
  id               String                @id @default(uuid())
  restauranteId    String
  restaurante      Restaurante           @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome             String
  categoria        String                // INGREDIENTE | BEBIDA | EMBALAGEM | LIMPEZA | OUTROS
  unidade          String                // kg, g, L, ml, un, cx, sc
  quantidadeAtual  Float                 @default(0)
  quantidadeMinima Float                 @default(0)
  precoUnitario    Float                 @default(0)
  fornecedor       String?
  ativo            Boolean               @default(true)
  movimentacoes    MovimentacaoEstoque[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model MovimentacaoEstoque {
  id            String      @id @default(uuid())
  restauranteId String
  itemId        String
  item          ItemEstoque @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipo          String      // ENTRADA | SAIDA | AJUSTE
  quantidade    Float
  precoUnitario Float?
  motivo        String      // COMPRA | PRODUCAO | DESPERDICIO | INVENTARIO | OUTRO
  observacao    String?
  criadoPor     String      @default("admin")
  createdAt     DateTime    @default(now())
}

model CustoMensal {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome          String
  categoria     String      // FIXO | VARIAVEL
  subcategoria  String      // ALUGUEL | FUNCIONARIO | ENERGIA | AGUA | INTERNET | FORNECEDOR | EMBALAGEM | MANUTENCAO | OUTRO
  valor         Float
  mes           String      // YYYY-MM
  observacao    String?
  createdAt     DateTime    @default(now())
}

model TurnoCaixa {
  id              String      @id @default(uuid())
  restauranteId   String
  restaurante     Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  status          String      @default("ABERTO") // ABERTO | FECHADO
  valorAbertura   Float       @default(0)
  valorFechamento Float?
  sangrias        Json        @default("[]") // [{valor, motivo, registradoPor, criadoEm}]
  totalVendas     Float       @default(0)
  totalDinheiro   Float       @default(0)
  totalCartao     Float       @default(0)
  totalPix        Float       @default(0)
  totalOutros     Float       @default(0)
  totalSangrias   Float       @default(0)
  observacao      String?
  abertoPor       String?
  fechadoPor      String?
  abertoEm        DateTime    @default(now())
  fechadoEm       DateTime?
  createdAt       DateTime    @default(now())
}

model Promocao {
  id               String      @id @default(uuid())
  restauranteId    String
  restaurante      Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome             String
  descricao        String?
  precoPromocional Float?
  ativa            Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}
